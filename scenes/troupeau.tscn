[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/panneau_troupeau.gd" id="1"]
[ext_resource type="Script" path="res://scripts/defile_moutons.gd" id="2"]

[node name="Troupeau" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 40
script = ExtResource("1")

[node name="Colonne" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Defile" type="Control" parent="Colonne"]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
mouse_filter = 2
script = ExtResource("2")

[node name="Gains" type="Label" parent="Colonne"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Troupeau : +0,0 par seconde"

[node name="Boutons" type="VBoxContainer" parent="Colonne"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16
